rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null && request.auth.uid == "PASTE_OWNER_AUTH_UID";
    }

    match /videos/{ownerUid}/{fileName} {
      allow read: if true;
      allow write: if isOwner()
        && request.auth.uid == ownerUid
        && request.resource != null
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
